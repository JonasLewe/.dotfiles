#!/usr/bin/env python3
"""Run networkmanager-dmenu with new Wi-Fi profiles scoped to this user."""

from importlib import machinery, util
import os
from pathlib import Path
import pwd


UPSTREAM_SCRIPT = Path(
    os.environ.get("NETWORKMANAGER_DMENU_SCRIPT", "/usr/bin/networkmanager_dmenu")
)


def load_upstream():
    if not UPSTREAM_SCRIPT.is_file():
        raise SystemExit(
            "networkmanager_dmenu is missing; install the networkmanager-dmenu package"
        )

    loader = machinery.SourceFileLoader(
        "networkmanager_dmenu_upstream", str(UPSTREAM_SCRIPT)
    )
    spec = util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"Could not load {UPSTREAM_SCRIPT}")

    module = util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def main():
    module = load_upstream()
    create_wifi_profile = module.create_wifi_profile
    username = pwd.getpwuid(os.getuid()).pw_name

    def create_user_wifi_profile(access_point, password, adapter):
        profile = create_wifi_profile(access_point, password, adapter)
        connection = profile.get_setting_connection()
        if connection is None or not connection.add_permission(
            "user", username, None
        ):
            raise RuntimeError("Could not scope the Wi-Fi profile to the current user")
        return profile

    module.create_wifi_profile = create_user_wifi_profile
    module.main()


if __name__ == "__main__":
    main()
