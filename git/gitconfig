[user]
	name = Jonas Lewe
	# Email is set per-machine in ~/.gitconfig.local
	# Run install.sh or copy git/gitconfig.local.example to ~/.gitconfig.local

[include]
	path = ~/.gitconfig.local

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
	default = current

[alias]
	st = status
	co = checkout
	br = branch

[color]
	ui = auto

[branch]
	autoSetupMerge = simple
[hook "ciso-vr"]
	event = pre-commit
	command = [ ! -d /opt/vault-radar ] && exit 0 || exec sh /opt/vault-radar/hooks.d/confighook/pre-commit
[hook "ciso-vr-prepush"]
	event = pre-push
	command = [ ! -d /opt/vault-radar ] && exit 0 || exec sh /opt/vault-radar/hooks.d/confighook/pre-push
