# Sensitive files - DO NOT COMMIT
zsh/zshrc.local
.zshrc.local
ssh/config
git/gitconfig.local

# External repos (installed separately)
ghostty/shaders/

# Platform-specific symlink (created by install.sh)
ghostty/platform.conf

# Local Ghostty preferences (bootstrapped from config.example)
ghostty/config

# Binaries (downloaded/extracted, not part of dotfiles)
nvim-linux-x86_64/
nvim-linux-arm64/
lazygit

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Karabiner automatic backups
karabiner/automatic_backups/

# Neovim
*.swp
*.swo
*~

# Logs
*.log

# Local Python environments
.venv/

# Local machine-specific configs
*.local
!*.local.example
.dual-graph/
