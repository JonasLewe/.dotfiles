# Login-shell environment shared by Ghostty, tmux and interactive shells.

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"
export MANPATH="$HOME/.local/share/man:$(manpath -q 2>/dev/null)"

# A TTY1 login replaces the shell with Hyprland; other sessions are untouched.
if [[ "$(uname)" == "Linux" ]]; then
  if [[ -z "$WAYLAND_DISPLAY" && -n "$XDG_VTNR" && "$XDG_VTNR" -eq 1 ]]; then
    exec start-hyprland &>~/.cache/hyprland.log
  fi
fi
